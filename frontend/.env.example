# ─── Frontend Environment Variables ──────────────────────────────────────────
# For LOCAL development: create a file called .env.local with:
#   REACT_APP_API_URL=http://localhost:5000
#
# For PRODUCTION (Vercel): set in Vercel Dashboard → Project → Settings → Environment Variables:
#   REACT_APP_API_URL=https://YOUR_RENDER_BACKEND.onrender.com
#
# Note: Variables MUST start with REACT_APP_ to be available in the React build.

REACT_APP_API_URL=https://YOUR_RENDER_BACKEND.onrender.com
