# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env for local development.
# On Render, set these in: Dashboard → Your Service → Environment

# MongoDB Atlas connection string (for production)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/clothes-rental?retryWrites=true&w=majority

# Local MongoDB (for development only — replace the above URI in .env)
# MONGODB_URI=mongodb://127.0.0.1:27017/clothes-rental

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE=7d

# Server port (Render sets this automatically; leave as 5000 for local)
PORT=5000

# NODE_ENV — set to 'production' on Render
NODE_ENV=production

# ─── CORS — Allowed Frontend Origins ─────────────────────────────────────────
# Comma-separated list of your Vercel deployment URLs.
# Example (add all preview URLs you use):
#   CLIENT_URL=https://rentwear-marketplace.vercel.app,https://rentwear-git-main-yourname.vercel.app
CLIENT_URL=https://YOUR_APP.vercel.app
